		default = "portrait",
		supported = { "portrait" },
	},
	android =
  {
			 minSdkVersion = "19",

      applicationChildElements =
      {
          -- Array of strings
          [[
					<meta-data
					android:name="com.google.android.gms.ads.APPLICATION_ID"
